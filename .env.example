# ─── Media Stack (rama coolify) ───────────────────────────────────────────────
# En Coolify estas variables NO se ponen en un .env: se cargan como variables
# de entorno del recurso (Environment Variables), y Coolify se las inyecta al
# compose. Este fichero queda como referencia y para correr el stack a mano.
#
# El almacenamiento ya no se configura con CONFIG_DIR/DATA_DIR: esta rama usa
# volúmenes Docker nombrados (media_data + un volumen de config por app).

# Zona horaria de todas las apps.
TZ=Europe/Madrid

# Usuario/grupo con el que corren las apps y dueño de /data.
PUID=1000
PGID=1000

# URL pública del reverse proxy (la que apunta al servicio `caddy`).
# La usa Jellyfin para anunciar su dirección a los clientes.
PUBLIC_URL=https://media.82-223-54-242.sslip.io
